FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Load the AMR function object library
libs            (amrFunctionObjects);

application     MPPICDyMFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.5;

deltaT          2e-4;

writeControl    runTime;

writeInterval   0.05;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

functions
{
    // loadBalancedAMR functionObject: AMR + Load Balancing
    // This demonstrates using AMR/LB as a functionObject with a mesh
    // that has its own dynamic mesh type (dynamicMotionSolverFvMesh)
    loadBalancedAMR
    {
        type            loadBalancedAMR;
        libs            (amrFunctionObjects);

        // Error estimator: return 0 everywhere (no refinement/unrefinement)
        // This simplifies testing to focus on load balancing
        errorEstimator  coded;
        name            zeroError;

        // cloudHandler is auto-discovered but can be explicitly set
        cloudHandler    kinematicCloudHandler;

        code
        #{
            // Refine the lower half of the column where particles settle
            volScalarField& err = error();
            const vectorField& C = mesh().C();
            forAll(err, celli)
            {
                if (C[celli].z() < 0.15)
                {
                    err[celli] = 1.0;  // Refine in lower region
                }
                else
                {
                    err[celli] = -1.0;  // Unrefine in upper region
                }
            }
        #};

        // Enable load balancing (only active in parallel)
        balance         yes;

        // Enable AMR refinement/unrefinement
        refine          true;
        unrefine        true;

        // AMR settings (same format as adaptiveFvMesh)
        refiner         hexRefiner;

        refineInterval  5;
        unrefineInterval 5;
        balanceInterval 5;

        maxRefinement   2;

        nBufferLayers   1;
        nRefinementBufferLayers 1;
        nUnrefinementBufferLayers 2;

        // Thresholds (not used when refine/unrefine are false, but required)
        lowerRefineLevel 0.5;
        upperRefineLevel 1e10;
        unrefineLevel   0.5;
        upperUnrefineLevel 1e10;

        dumpLevel       no;
    }
}


