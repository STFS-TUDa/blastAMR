FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Load the AMR function object library
libs            (amrFunctionObjects);

application     MPPICDyMFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.5;

deltaT          2e-4;

writeControl    runTime;

writeInterval   0.05;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

functions
{
    // loadBalancedAMR functionObject: Mesh Motion + Load Balancing
    // This tutorial demonstrates:
    // 1. Solid body mesh motion (oscillating column) via dynamicMotionSolverFvMesh
    // 2. Particle-aware load balancing using the cellCount policy
    // The oscillating mesh combined with moving particles creates load imbalance
    // that triggers redistribution.
    loadBalancedAMR
    {
        type            loadBalancedAMR;
        libs            (amrFunctionObjects);

        // Error estimator: return 0 everywhere (no refinement/unrefinement)
        errorEstimator  coded;
        name            zeroError;
        code
        #{
            // Return zero error everywhere - no refinement
            error() = dimensionedScalar("zero", dimless, 0);
        #};

        // Enable load balancing (only active in parallel)
        // updateMesh() is now called after redistribution to refresh
        // injection model cell caches.
        balance         yes;

        // Disable AMR refinement/unrefinement - only do load balancing
        refine          false;
        unrefine        false;

        // Load balancing settings
        // Low interval to test load balancing frequently
        balanceInterval 10;

        // Use cellCount policy with particle-aware load calculation
        // load = cellCount + particleCoeff * particleCount
        loadPolicy      cellCount;
        particleCoeff   100.0;      // Weight of each particle relative to a cell
        allowedImbalance 0.01;      // Trigger rebalancing at 1% imbalance

        // AMR settings (not used but some are required by the refiner)
        refiner         hexRefiner;
        refineInterval  100;
        maxRefinement   1;
        nBufferLayers   1;
        lowerRefineLevel 0.5;
        upperRefineLevel 1e10;
        unrefineLevel   0.5;

        dumpLevel       yes;
    }
}


