FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh   adaptiveFvMesh;

errorEstimator  fieldValue;

fieldName       test;

balance         no;

refiner         polyRefiner;

refineInterval  1;

unrefineInterval 1;

balanceInterval 1;

lowerRefineLevel 0.01;

unrefineLevel   0.01;

nBufferLayers   2;

maxRefinement   3;

dumpLevel       false;

protectedPatches ( fixedWalls );

nPatchesBuffers 2;


